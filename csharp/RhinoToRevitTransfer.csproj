<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>RhinoToRevitTransfer</AssemblyName>
    <RootNamespace>RhinoToRevitTransfer</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <!-- RhinoCommon reference (Rhino 8) -->
    <PackageReference Include="RhinoCommon" Version="8.21.25188.17001" ExcludeAssets="runtime" />
    <PackageReference Include="RhinoWindows" Version="8.21.25188.17001" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" Condition="'$(TargetFramework)' == 'net48'" PrivateAssets="All" />
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2024.0.0" Condition="'$(TargetFramework)' == 'net48'" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Local / Installed Revit and Rhino.Inside references for net8.0-windows (Revit 2025/2026) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Reference Include="RevitAPI">
      <HintPath>C:\ProgramData\Autodesk\Revit\Macros\2026\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\ProgramData\Autodesk\Revit\Macros\2026\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RhinoInside.Revit">
      <HintPath>C:\ProgramData\Autodesk\Revit\Addins\2026\RhinoInside.Revit\R8\RhinoInside.Revit.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Fallback references for net48 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="RhinoInside.Revit">
      <HintPath>$(AppData)\Autodesk\Revit\Addins\2024\RhinoInside.Revit\RhinoInside.Revit.dll</HintPath>
      <HintPath Condition="!Exists('$(AppData)\Autodesk\Revit\Addins\2024\RhinoInside.Revit\RhinoInside.Revit.dll')">C:\ProgramData\Autodesk\Revit\Addins\2026\RhinoInside.Revit\R8\RhinoInside.Revit.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
