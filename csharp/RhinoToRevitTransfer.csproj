<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Use net48 for Revit 2020-2024, or net8.0-windows for Revit 2025+ -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>RhinoToRevitTransfer</AssemblyName>
    <RootNamespace>RhinoToRevitTransfer</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- RhinoCommon reference (Rhino 7 or Rhino 8) -->
    <PackageReference Include="RhinoCommon" Version="7.34.23294.7001" Condition="'$(TargetFramework)' == 'net48'" ExcludeAssets="runtime" />
    <PackageReference Include="RhinoCommon" Version="8.5.24072.13001" Condition="'$(TargetFramework)' == 'net8.0-windows'" ExcludeAssets="runtime" />
    <PackageReference Include="RhinoWindows" Version="7.34.23294.7001" Condition="'$(TargetFramework)' == 'net48'" ExcludeAssets="runtime" />
    
    <!-- Revit API references (e.g. Revit 2024 or 2025) -->
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2024.0.0" Condition="'$(TargetFramework)' == 'net48'" ExcludeAssets="runtime" />
    
    <!-- Rhino.Inside.Revit API reference -->
    <!-- When installed locally, can reference: %APPDATA%\Autodesk\Revit\Addins\2024\RhinoInside.Revit\RhinoInside.Revit.dll -->
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="RhinoInside.Revit">
      <HintPath>$(AppData)\Autodesk\Revit\Addins\2024\RhinoInside.Revit\RhinoInside.Revit.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
