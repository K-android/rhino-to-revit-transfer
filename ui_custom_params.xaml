<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deterministic Custom Parameters"
        Width="740" Height="560"
        MinWidth="600" MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9"
        FontFamily="Segoe UI"
        FontSize="12.5"
        Foreground="#1A2230"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DCE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0066CC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0052A3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="TokenButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,4,6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Scope Badge -->
        <StackPanel Grid.Row="0" Margin="14,12,14,8">
            <TextBlock x:Name="lbl_cp_header" Text="Deterministic Custom Parameters" FontSize="15" FontWeight="Bold" Foreground="#1A2230"/>
            <Border x:Name="border_cp_scope" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
                <TextBlock x:Name="lbl_cp_scope" Text="Mode capabilities" FontSize="11.5" Foreground="#1E40AF" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Parameters Grid -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" Margin="14,0,14,10">
            <DataGrid x:Name="grid_params" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" SelectionMode="Single" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EDF0F5" BorderThickness="0" HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="1.2*" Binding="{Binding [Name]}"/>
                    <DataGridTextColumn Header="Kind" Width="85" Binding="{Binding [Kind]}"/>
                    <DataGridTextColumn Header="Type" Width="80" Binding="{Binding [Type]}"/>
                    <DataGridTextColumn Header="Scope" Width="75" Binding="{Binding [Scope]}"/>
                    <DataGridTextColumn Header="Value / Formula" Width="1.6*" Binding="{Binding [ValueRule]}"/>
                    <DataGridTextColumn Header="Constraint Target" Width="105" Binding="{Binding [ConstraintTarget]}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Form Editor Card -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="14,0,14,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PARAMETER NAME" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="txt_name" Padding="6,4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DATA TYPE" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <ComboBox x:Name="dd_type" Padding="6,4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="SCOPE" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <ComboBox x:Name="dd_scope" Padding="6,4"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="lbl_scope_hint" Text="Note: DirectShape supports Instance parameters only."
                           FontSize="11" Foreground="#5A6577" Margin="0,4,0,0" Visibility="Collapsed"/>

                <TextBlock Text="VALUE RULE (LITERAL, @usertext:Key, OR TOKENS)" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,10,0,3"/>
                <TextBox x:Name="txt_value_expr" Padding="6,4"/>
                <WrapPanel>
                    <Button x:Name="btn_tok_usertext" Content="+ @usertext:Key" Style="{StaticResource TokenButton}"/>
                    <Button x:Name="btn_tok_layer" Content="+ {layer}" Style="{StaticResource TokenButton}"/>
                    <Button x:Name="btn_tok_level" Content="+ {level}" Style="{StaticResource TokenButton}"/>
                    <Button x:Name="btn_tok_material" Content="+ {material}" Style="{StaticResource TokenButton}"/>
                    <Button x:Name="btn_tok_area" Content="+ {area_sqm}" Style="{StaticResource TokenButton}"/>
                </WrapPanel>

                <TextBlock x:Name="lbl_const_sec" Text="Editable Family Constraints &amp; Formulas:" FontSize="11.5" FontWeight="SemiBold" Margin="0,10,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="dd_constraint" Grid.Column="0" Padding="6,4"/>
                    <TextBox x:Name="txt_formula" Grid.Column="2" Padding="6,4" ToolTip="Revit family formula (e.g. Width * 2)"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="btn_add_param" Content="Add / Update Parameter" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button x:Name="btn_rem_param" Content="Remove Selected" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#DCE2EA" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btn_cp_cancel" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button x:Name="btn_cp_ok" Content="Save Parameters" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
