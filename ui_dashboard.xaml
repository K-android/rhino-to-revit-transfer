<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rhino-to-Revit Transfer (R2R)"
        Width="1180" Height="760"
        MinWidth="920" MinHeight="580"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9"
        FontFamily="Segoe UI"
        FontSize="12.5"
        Foreground="#1A2230"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DCE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5A6577"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0066CC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0052A3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0052A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#94B8E0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94B8E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepPillButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#DCE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0066CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DCE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF0F5"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#DCE2EA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1A2230"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EBF3FD"/>
                    <Setter Property="Foreground" Value="#1A2230"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#1A2230"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: Top Header & 3-Step Navigation -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DCE2EA" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="R2R Transfer" FontSize="15" FontWeight="Bold" Foreground="#0066CC"/>
                    <TextBlock x:Name="lbl_header_settings" Text="Hybrid · Auto Units · Auto-Fallback" FontSize="11" Foreground="#5A6577"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                    <Button x:Name="btn_step_scan" Content="1. Scan" Style="{StaticResource StepPillButton}"/>
                    <Button x:Name="btn_step_configure" Content="2. Configure Layers" Style="{StaticResource StepPillButton}"/>
                    <Button x:Name="btn_step_run" Content="3. Transfer &amp; QA" Style="{StaticResource StepPillButton}"/>
                </WrapPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btn_load_profile" Content="Load Profile" Style="{StaticResource SubtleButton}" Margin="0,0,6,0"/>
                    <Button x:Name="btn_save_profile" Content="Save Profile" Style="{StaticResource SubtleButton}" Margin="0,0,6,0"/>
                    <Button x:Name="btn_open_settings" Content="Settings &amp; AI..." Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: Main Step Content Area -->
        <Grid Grid.Row="1">

            <!-- STEP 1: SCAN -->
            <ScrollViewer x:Name="panel_step_scan" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                <StackPanel MaxWidth="920" Margin="20,18">
                    <!-- Hero Scan Card -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Scan Active Rhino Model" FontSize="16" FontWeight="Bold" Foreground="#1A2230"/>
                                <TextBlock Text="Inspects layer hierarchy, detects prismatic vs. freeform geometry, checks coordinates against Revit's 16km origin limit, and matches existing Revit sync IDs."
                                           TextWrapping="Wrap" Foreground="#5A6577" Margin="0,5,0,12"/>
                                <WrapPanel>
                                    <CheckBox x:Name="chk_include_hidden" Content="Include Hidden Layers" IsChecked="False" Margin="0,0,18,6"/>
                                    <CheckBox x:Name="chk_include_locked" Content="Include Locked Layers" IsChecked="False" Margin="0,0,18,6"/>
                                    <CheckBox x:Name="chk_auto_split_mixed" Content="Auto-split mixed-geometry layers" IsChecked="True" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </StackPanel>
                            <Button x:Name="btn_scan" Grid.Column="1" Content="Scan Active Rhino Document"
                                    Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="18,11" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Preflight KPI Cards -->
                    <TextBlock Text="PREFLIGHT &amp; GEOMETRIC HEALTH SUMMARY" FontSize="11.5" FontWeight="Bold" Foreground="#5A6577" Margin="2,0,0,8"/>
                    <UniformGrid Columns="4" Margin="-5,0,-5,14">
                        <Border Style="{StaticResource CardBorder}" Margin="5">
                            <StackPanel>
                                <TextBlock Text="SCANNED OBJECTS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="lbl_kpi_total" Text="0" FontSize="22" FontWeight="Bold" Foreground="#0066CC" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="5">
                            <StackPanel>
                                <TextBlock Text="RHINO UNITS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="lbl_kpi_units" Text="Not Scanned" FontSize="14" FontWeight="SemiBold" Foreground="#1A2230" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="5">
                            <StackPanel>
                                <TextBlock Text="ORIGIN &amp; DUPLICATES" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="lbl_kpi_origin" Text="Far (>16km): 0" FontSize="13" FontWeight="SemiBold" Foreground="#1A2230" Margin="0,6,0,2"/>
                                <TextBlock x:Name="lbl_kpi_duplicates" Text="Duplicates: 0" FontSize="12" Foreground="#5A6577"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="5">
                            <StackPanel>
                                <TextBlock Text="OPEN BOUNDARY LOOPS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="lbl_kpi_loops" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1A2230" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Preflight Warnings Card -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="PREFLIGHT NOTICES &amp; WARNINGS" FontSize="11" FontWeight="Bold" Foreground="#5A6577" Margin="0,0,0,8"/>
                            <TextBox x:Name="txt_scan_warnings" Text="No preflight warnings. Click 'Scan Active Rhino Document' to begin."
                                     MinHeight="130" MaxHeight="240" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" BorderBrush="#E2E8F0" Background="#F8FAFC" Padding="8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- STEP 2: CONFIGURE LAYERS (MASTER-DETAIL SPLIT VIEW) -->
            <Grid x:Name="panel_step_configure" Margin="14,10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Non-Clipping Wrapping Filter & Utility Toolbar -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="10,8" Margin="0,0,0,10">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Foreground="#5A6577" FontWeight="SemiBold" Margin="0,4,6,4"/>
                        <TextBox x:Name="txt_search" Width="185" Padding="6,4" Margin="0,4,10,4" ToolTip="Filter by Rhino layer name"/>

                        <TextBlock Text="Status:" VerticalAlignment="Center" Foreground="#5A6577" FontWeight="SemiBold" Margin="0,4,6,4"/>
                        <ComboBox x:Name="dd_status_filter" Width="145" Margin="0,4,10,4"/>

                        <TextBlock Text="Category:" VerticalAlignment="Center" Foreground="#5A6577" FontWeight="SemiBold" Margin="0,4,6,4"/>
                        <ComboBox x:Name="dd_cat_filter" Width="130" Margin="0,4,12,4"/>

                        <Button x:Name="btn_select_all" Content="Select All" Style="{StaticResource SubtleButton}" Margin="0,4,6,4"/>
                        <Button x:Name="btn_deselect_all" Content="None" Style="{StaticResource SubtleButton}" Margin="0,4,10,4"/>
                        <Button x:Name="btn_split_mixed" Content="Split Mixed Layers" Style="{StaticResource SecondaryButton}" Margin="0,4,6,4"
                                ToolTip="Split heterogeneous Rhino layers into homogeneous sub-rows by geometry type"/>
                        <Button x:Name="btn_ai_assist" Content="AI Assist" Style="{StaticResource SecondaryButton}" Margin="0,4,6,4"
                                ToolTip="Classify ambiguous layer names using configured AI / heuristics"/>
                        <Button x:Name="btn_project_params" Content="Project Params (0)..." Style="{StaticResource SecondaryButton}" Margin="0,4,0,4"
                                ToolTip="Configure deterministic Shared Parameters applied across all transferred elements"/>
                    </WrapPanel>
                </Border>

                <!-- Master-Detail Split Grid -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" MinWidth="440"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*" MinWidth="330" MaxWidth="480"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT MASTER LIST -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                        <DataGrid x:Name="grid_review" Style="{StaticResource CleanDataGridStyle}" SelectionMode="Extended" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="38">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding [Checked], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Rhino Layer" Width="2.1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,1">
                                                <TextBlock Text="{Binding [LayerName]}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding [LayerName]}"/>
                                                <TextBlock Text="{Binding [PatternSub]}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Qty" Width="48" Binding="{Binding [CountText]}"/>

                                <DataGridTemplateColumn Header="Revit Target" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,1">
                                                <TextBlock Text="{Binding [TargetLine1]}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding [TargetLine2]}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Status" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="9" Padding="8,2" Background="{Binding [StatusBg]}" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding [StatusText]}" Foreground="{Binding [StatusFg]}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- SPLITTER -->
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="Transparent" ResizeBehavior="PreviousAndNext"/>

                    <!-- RIGHT DETAIL INSPECTOR -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14">
                            <Grid>
                                <!-- Empty Selection Prompt -->
                                <StackPanel x:Name="panel_inspector_empty" VerticalAlignment="Center" Margin="16,40">
                                    <TextBlock Text="Layer Inspector" FontSize="15" FontWeight="Bold" Foreground="#1A2230" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Click any layer on the left to inspect geometry rules, choose a plain-English Revit transfer mode, search Revit materials, or attach custom parameters. Hold Ctrl or Shift to bulk-edit multiple layers."
                                               TextWrapping="Wrap" TextAlignment="Center" Foreground="#64748B" LineHeight="19"/>
                                </StackPanel>

                                <!-- Active Single / Multi Inspector Body -->
                                <StackPanel x:Name="panel_inspector_body" Visibility="Collapsed">
                                    <TextBlock x:Name="lbl_insp_title" Text="Layer Name" FontSize="14.5" FontWeight="Bold" Foreground="#1A2230" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="lbl_insp_subtitle" Text="0 objects · Create" FontSize="11.5" Foreground="#5A6577" TextWrapping="Wrap" Margin="0,2,0,10"/>

                                    <!-- Geometry Summary & Mixed Split Card -->
                                    <Border x:Name="border_insp_geom" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="DETECTED GEOMETRY" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="lbl_insp_geom" Text="Unique Mesh/Brep" TextWrapping="Wrap" Foreground="#1E293B"/>
                                            <Button x:Name="btn_insp_split" Content="Split This Mixed Layer" Style="{StaticResource SecondaryButton}"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>

                                    <CheckBox x:Name="chk_insp_include" Content="Include layer in Revit transfer" IsChecked="True" FontWeight="SemiBold" Margin="0,2,0,4"/>

                                    <!-- Revit Category -->
                                    <TextBlock Text="REVIT CATEGORY" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cb_insp_category" IsEditable="True" IsTextSearchEnabled="True" Padding="6,5" HorizontalAlignment="Stretch"/>

                                    <!-- Transfer Mode -->
                                    <TextBlock Text="TRANSFER MODE (REVIT STRATEGY)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cb_insp_strategy" Padding="6,5" HorizontalAlignment="Stretch"/>

                                    <!-- Editability Badge -->
                                    <Border x:Name="border_insp_editability" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,6,0,0">
                                        <TextBlock x:Name="lbl_insp_editability" Text="Editability" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E40AF" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Rule Compatibility Banner -->
                                    <Border x:Name="border_insp_compat" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="lbl_insp_compat" Text="Compatible" FontSize="11.5" TextWrapping="Wrap" Foreground="#166534"/>
                                            <Button x:Name="btn_insp_use_rec" Content="Use Recommended" Style="{StaticResource SecondaryButton}"
                                                    HorizontalAlignment="Left" Margin="0,7,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Searchable Revit Material -->
                                    <TextBlock Text="REVIT MATERIAL (TYPE TO SEARCH)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cb_insp_material" IsEditable="True" IsTextSearchEnabled="True" Padding="6,5" HorizontalAlignment="Stretch"/>

                                    <!-- Deterministic Custom Parameters -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="DETERMINISTIC CUSTOM PARAMETERS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="lbl_insp_params_summary" Text="0 layer-specific + 0 project-wide parameters" TextWrapping="Wrap" Foreground="#334155" Margin="0,0,0,8"/>
                                            <Button x:Name="btn_insp_params" Content="Configure Layer Parameters..." Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bulk Edit Action Bar (Shown only when >1 row is selected) -->
                                    <StackPanel x:Name="panel_insp_bulk" Visibility="Collapsed" Margin="0,12,0,0">
                                        <Button x:Name="btn_insp_bulk_apply" Content="Apply to Selected Layers" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- STEP 3: TRANSFER & QA -->
            <Grid x:Name="panel_step_run" Margin="14,10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Run Header & Progress Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock x:Name="lbl_run_summary" Text="Ready: 0 Create | 0 Update | 0 Skip | 0 Mixed" FontSize="14" FontWeight="Bold" Foreground="#1A2230"/>
                            <ProgressBar x:Name="progress_bar" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,6"/>
                            <TextBlock x:Name="lbl_exec_status" Text="Status: Idle. Review summary and click 'Execute R2R Transfer' to run Revit API transactions." Foreground="#5A6577" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="btn_execute" Grid.Column="1" Content="Execute R2R Transfer"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="20,11" FontSize="13"/>
                    </Grid>
                </Border>

                <!-- Collapsible Live Execution Log -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10,6" Margin="0,0,0,10">
                    <Expander x:Name="exp_exec_log" Header="Live Execution Log" IsExpanded="True" FontWeight="SemiBold" Foreground="#1A2230">
                        <TextBox x:Name="txt_exec_log" Height="135" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" FontWeight="Normal"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderBrush="#E2E8F0" Background="#F8FAFC" Padding="8" Margin="0,8,0,2"/>
                    </Expander>
                </Border>

                <!-- Validation & QA Audit Card -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Dual-Status BIM &amp; Graphics Validation Audit" FontSize="13.5" FontWeight="Bold" Foreground="#1A2230" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btn_isolate" Content="Isolate in Revit" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                        ToolTip="Highlight and isolate selected element in the active Revit view"/>
                                <Button x:Name="btn_export_html" Content="Export HTML" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                                <Button x:Name="btn_export_csv" Content="Export CSV" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid x:Name="grid_validate" Grid.Row="1" Style="{StaticResource CleanDataGridStyle}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Revit ID" Width="72" Binding="{Binding [RevitId]}"/>
                                <DataGridTextColumn Header="Layer" Width="1.3*" Binding="{Binding [Layer]}"/>
                                <DataGridTextColumn Header="Category &amp; Mode" Width="1.3*" Binding="{Binding [CategoryMode]}"/>
                                <DataGridTextColumn Header="Area (m²)" Width="72" Binding="{Binding [Area]}"/>
                                <DataGridTextColumn Header="Vol (m³)" Width="72" Binding="{Binding [Volume]}"/>
                                <DataGridTextColumn Header="Material" Width="1.2*" Binding="{Binding [Material]}"/>
                                <DataGridTemplateColumn Header="Status" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="9" Padding="8,2" Background="{Binding [StatusBg]}" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding [Status]}" Foreground="{Binding [StatusFg]}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Views &amp; Issues" Width="1.8*" Binding="{Binding [ViewsIssues]}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ROW 2: Persistent Wizard Footer -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DCE2EA" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lbl_global_status" Grid.Column="0" Text="Ready to scan active Rhino document."
                           VerticalAlignment="Center" Foreground="#475569" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="11" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="lbl_footer_summary" Text="0 layers · 0 objects" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                    </Border>
                    <Button x:Name="btn_back" Content="&lt;- Back" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Visibility="Collapsed"/>
                    <Button x:Name="btn_next" Content="Next: Configure ->" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
