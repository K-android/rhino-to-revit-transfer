<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer Settings &amp; AI Configuration"
        Width="620" Height="590"
        MinWidth="500" MinHeight="440"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9"
        FontFamily="Segoe UI"
        FontSize="12.5"
        Foreground="#1A2230"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DCE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0066CC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0052A3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
            <StackPanel>
                <!-- Card 1: Transfer & Geometry Rules -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Transfer &amp; Geometry Rule Settings" FontSize="14" FontWeight="Bold" Foreground="#1A2230" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Execution Mode:" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" Margin="0,6"/>
                            <ComboBox x:Name="dd_global_mode" Grid.Row="0" Grid.Column="1" Padding="6,4" Margin="0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Unit Scale:" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" Margin="0,6"/>
                            <ComboBox x:Name="dd_unit_scale" Grid.Row="1" Grid.Column="1" Padding="6,4" Margin="0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Mixed / Incompatible:" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" Margin="0,6"/>
                            <ComboBox x:Name="dd_mixed_policy" Grid.Row="2" Grid.Column="1" Padding="6,4" Margin="0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Repetition Threshold:" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" Margin="0,6"/>
                            <ComboBox x:Name="dd_rep_threshold" Grid.Row="3" Grid.Column="1" Padding="6,4" Margin="0,6"/>
                        </Grid>

                        <CheckBox x:Name="chk_move_to_origin" Content="Move Model to Revit Origin (0,0,0)" IsChecked="True" Margin="0,12,0,6"
                                  ToolTip="Centers model XY at Revit (0,0) and normalizes base elevation even if >16km from Rhino origin"/>
                        <CheckBox x:Name="chk_gen_bua" Content="Auto-Generate BUA / GFA Area Boundary Lines" IsChecked="True" Margin="0,2,0,2"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: AI Semantic Classifier -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="AI Semantic Classifier &amp; API Key" FontSize="14" FontWeight="Bold" Foreground="#1A2230"/>
                        <TextBlock Text="Optional LLM provider to decode complex or multilingual architectural layer names." Foreground="#5A6577" TextWrapping="Wrap" Margin="0,3,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="LLM Provider:" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" Margin="0,5"/>
                            <ComboBox x:Name="dd_ai_provider" Grid.Row="0" Grid.Column="1" Padding="6,4" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Model Preset:" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" Margin="0,5"/>
                            <ComboBox x:Name="dd_ai_model" Grid.Row="1" Grid.Column="1" Padding="6,4" Margin="0,5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Model Name:" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" Margin="0,5"/>
                            <TextBox x:Name="txt_ai_custom_model" Grid.Row="2" Grid.Column="1" Padding="6,4" Margin="0,5"
                                     ToolTip="e.g. gpt-4o-mini, gemini-2.5-flash"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="API Key:" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" Margin="0,5"/>
                            <TextBox x:Name="txt_ai_api_key" Grid.Row="3" Grid.Column="1" Padding="6,4" Margin="0,5"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="API Endpoint:" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" Margin="0,5"/>
                            <TextBox x:Name="txt_ai_endpoint" Grid.Row="4" Grid.Column="1" Padding="6,4" Margin="0,5"/>
                        </Grid>

                        <DockPanel Margin="0,10,0,0">
                            <Button x:Name="btn_ai_test" Content="Test Connection" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                            <TextBlock x:Name="lbl_ai_status" Text="Stored locally in %APPDATA%/pyRevit/R2R/ai_config.json"
                                       VerticalAlignment="Center" Foreground="#5A6577" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#DCE2EA" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btn_settings_cancel" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button x:Name="btn_settings_save" Content="Save &amp; Apply" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
